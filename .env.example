# Local development only; production uses verified HTTPS through a reverse proxy.
AITICKET_DATA=data
# Keep the key outside the database volume in production.
AITICKET_KEY_FILE=data/encryption.key
# Set only for loopback HTTP development; unset for production.
AITICKET_LOCAL_HTTP=1

# Set to this server’s LAN IP to receive UniFi syslog on UDP/TCP 5514.
# Add allowed sender IPs in Settings > Network logs.
AITICKET_SYSLOG_BIND_ADDRESS=127.0.0.1

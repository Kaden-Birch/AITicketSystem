[Unit]
Description=AITicketSystem outbound Linux monitoring agent
After=network-online.target
Wants=network-online.target
[Service]
User=root
Group=root
PrivateUsers=false
DynamicUser=false
ExecStart=/usr/bin/python3 /opt/aiticket-agent/agent.py run
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=10
StateDirectory=aiticket-agent
StateDirectoryMode=0700
NoNewPrivileges=false
ProtectSystem=off
ProtectHome=false
PrivateTmp=false
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=false
RestrictSUIDSGID=false
MemoryMax=512M
CPUQuota=100%
[Install]
WantedBy=multi-user.target
